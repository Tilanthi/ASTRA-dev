\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Parameter dominance: Plasma $\beta $ vs Mach number $\mathcal  {M}$. Left panel: Density contrast $C_{\rm  final}$ vs $\beta $ at fixed $\mathcal  {M}=3.0$ (red circles). Right panel: $C_{\rm  final}$ vs $\mathcal  {M}$ at fixed $\beta =0.85$ (blue squares). The density contrast varies by a factor of 4.3 across the $\beta $-sweep but only by 20\% across the $\mathcal  {M}$-sweep, demonstrating that plasma $\beta $ is the primary control parameter for fragmentation vigour. Error bars show the range of $C$ values measured across different snapshots near $t = 4.0 t_J$.}}{45}{figure.4}\protected@file@percent }
\newlabel{fig:params_sweep}{{4}{45}{Parameter dominance: Plasma $\beta $ vs Mach number $\mathcal {M}$. Left panel: Density contrast $C_{\rm final}$ vs $\beta $ at fixed $\mathcal {M}=3.0$ (red circles). Right panel: $C_{\rm final}$ vs $\mathcal {M}$ at fixed $\beta =0.85$ (blue squares). The density contrast varies by a factor of 4.3 across the $\beta $-sweep but only by 20\% across the $\mathcal {M}$-sweep, demonstrating that plasma $\beta $ is the primary control parameter for fragmentation vigour. Error bars show the range of $C$ values measured across different snapshots near $t = 4.0 t_J$}{figure.4}{}}
