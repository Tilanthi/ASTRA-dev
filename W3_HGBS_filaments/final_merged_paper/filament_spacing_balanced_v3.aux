\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Campaign 8: Targeted supercritical test at $f = 1.5$ with extended 24$\lambda _{\rm  J}$ domain. \textbf  {Left}: Fragmentation times $t_{\rm  frag}$ for 5 independent turbulent seeds. All simulations fragmented with mean $t_{\rm  frag} = 0.707 \pm 0.012\,t_{\rm  J}$ (orange line), well below near-critical values ($\sim 1.1\,t_{\rm  J}$). \textbf  {Right}: $\lambda /W$ measurements at $t = 0.60\,t_{\rm  J}$ showing 24 uniformly-spaced high-density cores (red circles). The measured $\lambda /W = 3.333 \pm 0.000$ (blue dashed line) is consistent with near-critical Campaign 5 (3.44 $\pm $ 0.76) and Campaign 7 (3.38 $\pm $ 0.79) values, supporting smooth continuity across the critical transition.}}{19}{figure.17}\protected@file@percent }
\newlabel{fig:tsf15}{{17}{19}{Campaign 8: Targeted supercritical test at $f = 1.5$ with extended 24$\lambda _{\rm J}$ domain. \textbf {Left}: Fragmentation times $t_{\rm frag}$ for 5 independent turbulent seeds. All simulations fragmented with mean $t_{\rm frag} = 0.707 \pm 0.012\,t_{\rm J}$ (orange line), well below near-critical values ($\sim 1.1\,t_{\rm J}$). \textbf {Right}: $\lambda /W$ measurements at $t = 0.60\,t_{\rm J}$ showing 24 uniformly-spaced high-density cores (red circles). The measured $\lambda /W = 3.333 \pm 0.000$ (blue dashed line) is consistent with near-critical Campaign 5 (3.44 $\pm $ 0.76) and Campaign 7 (3.38 $\pm $ 0.79) values, supporting smooth continuity across the critical transition}{figure.17}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Cross-Campaign $\lambda /W$ Summary: Field Geometry and Plasma $\beta $ Dependence}}{19}{table.4}\protected@file@percent }
\newlabel{tab:cross_campaign}{{4}{19}{Cross-Campaign $\lambda /W$ Summary: Field Geometry and Plasma $\beta $ Dependence}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Cross-campaign $\lambda /W$ comparison. Longitudinal-field filaments (blue) show strong $\beta $-dependence: $\lambda /W$ decreases from $\sim 4.7$ at $\beta = 0.3$ to $\sim 2.8$ at $\beta = 2.0$. Perpendicular-field filaments (red) show $\lambda /W \approx 1.25$ (when $\beta \geq 1.0$, axial beading occurs) or FLAT profiles (when $\beta \leq 0.5$, pure radial collapse). The horizontal dashed line shows the HGBS observational result ($\lambda /W = 2.84 \pm 0.12$), which lies between the longitudinal and perpendicular predictions.}}{19}{figure.18}\protected@file@percent }
\newlabel{fig:cross_campaign_lambdaW}{{18}{19}{Cross-campaign $\lambda /W$ comparison. Longitudinal-field filaments (blue) show strong $\beta $-dependence: $\lambda /W$ decreases from $\sim 4.7$ at $\beta = 0.3$ to $\sim 2.8$ at $\beta = 2.0$. Perpendicular-field filaments (red) show $\lambda /W \approx 1.25$ (when $\beta \geq 1.0$, axial beading occurs) or FLAT profiles (when $\beta \leq 0.5$, pure radial collapse). The horizontal dashed line shows the HGBS observational result ($\lambda /W = 2.84 \pm 0.12$), which lies between the longitudinal and perpendicular predictions}{figure.18}{}}
