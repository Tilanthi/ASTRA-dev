\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Near-critical fragmentation threshold: $t_{\rm  frag}$ heatmaps in the $(\beta , f)$ plane for $\mathcal  {M} = 1$ (left) and $\mathcal  {M} = 2$ (right). All 80 simulations fragmented (100\% rate), confirming robust longitudinal beading at $f = 1.00$--$1.20$. Color bar shows $t_{\rm  frag}$ in units of $t_{\rm  J}$.}}{15}{figure.12}\protected@file@percent }
\newlabel{fig:beading_threshold}{{12}{15}{Near-critical fragmentation threshold: $t_{\rm frag}$ heatmaps in the $(\beta , f)$ plane for $\mathcal {M} = 1$ (left) and $\mathcal {M} = 2$ (right). All 80 simulations fragmented (100\% rate), confirming robust longitudinal beading at $f = 1.00$--$1.20$. Color bar shows $t_{\rm frag}$ in units of $t_{\rm J}$}{figure.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Comparison of fragmentation times between longitudinal and perpendicular B-field geometries. Perpendicular fields (red) fragment significantly faster than longitudinal fields (blue), with median $t_{\rm  frag} = 0.381\,t_{\rm  J}$ (perpendicular) versus $1.081\,t_{\rm  J}$ (longitudinal). Error bars show standard deviation across random seeds.}}{15}{figure.13}\protected@file@percent }
\newlabel{fig:perp_comparison}{{13}{15}{Comparison of fragmentation times between longitudinal and perpendicular B-field geometries. Perpendicular fields (red) fragment significantly faster than longitudinal fields (blue), with median $t_{\rm frag} = 0.381\,t_{\rm J}$ (perpendicular) versus $1.081\,t_{\rm J}$ (longitudinal). Error bars show standard deviation across random seeds}{figure.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Oblique field calibration: $t_{\rm  frag}$ versus field angle $\theta $ for $f = 1.5$--$3.0$ and $\beta = 0.5$--$2.0$. The smooth decrease from $0.604\,t_{\rm  J}$ ($30^\circ $) to $0.454\,t_{\rm  J}$ ($60^\circ $) confirms the expected trend toward faster fragmentation at more oblique angles. Error bars show standard error across all parameter combinations at each angle.}}{15}{figure.14}\protected@file@percent }
\newlabel{fig:oblique_calibration}{{14}{15}{Oblique field calibration: $t_{\rm frag}$ versus field angle $\theta $ for $f = 1.5$--$3.0$ and $\beta = 0.5$--$2.0$. The smooth decrease from $0.604\,t_{\rm J}$ ($30^\circ $) to $0.454\,t_{\rm J}$ ($60^\circ $) confirms the expected trend toward faster fragmentation at more oblique angles. Error bars show standard error across all parameter combinations at each angle}{figure.14}{}}
