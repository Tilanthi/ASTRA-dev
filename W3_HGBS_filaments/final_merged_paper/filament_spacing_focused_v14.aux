\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \textbf  {Theoretical} $\lambda /W_{\rm  core}$ vs.\ $\beta $ (y-axis: \textit  {simulation units} $\lambda /W_{\rm  core}$; \textit  {not} the observable $\lambda /W_{\rm  fil}$). Calibrated formula $\lambda _{\rm  frag} = 1.11\,\lambda _{MJ}(\theta ,\beta )$; no simulation points shown. At $\theta =0^\circ $, $\lambda /W_{\rm  core}=3.70$ (full numerical solution $3.55$--$3.80$). Green band: HGBS window $[2.52, 3.08]$ in observable $\lambda /W_{\rm  fil}$, corresponding to $[4.16, 5.08]$ in $\lambda /W_{\rm  core}$ at T1$=0.606$ (or $[3.56, 4.35]$ at T1$=0.707$); horizontal dashed line at $\lambda /W_{\rm  fil}=2.79$ (Gaia\nobreakspace  {}DR3) plotted in \textit  {observable} units for reference (right y-axis). To compare directly with HGBS, multiply y-axis values by T1$=0.606$--$0.707$. Valid at $f = 0.9$--$1.3$ only; \emph  {upper bound} for supercritical filaments (see Figure\nobreakspace  {}\ref  {fig:C7_critical} for direct simulation measurements).}}{10}{figure.11}\protected@file@percent }
\newlabel{fig:lambda_theory}{{11}{10}{\textbf {Theoretical} $\lambda /W_{\rm core}$ vs.\ $\beta $ (y-axis: \textit {simulation units} $\lambda /W_{\rm core}$; \textit {not} the observable $\lambda /W_{\rm fil}$). Calibrated formula $\lambda _{\rm frag} = 1.11\,\lambda _{MJ}(\theta ,\beta )$; no simulation points shown. At $\theta =0^\circ $, $\lambda /W_{\rm core}=3.70$ (full numerical solution $3.55$--$3.80$). Green band: HGBS window $[2.52, 3.08]$ in observable $\lambda /W_{\rm fil}$, corresponding to $[4.16, 5.08]$ in $\lambda /W_{\rm core}$ at T1$=0.606$ (or $[3.56, 4.35]$ at T1$=0.707$); horizontal dashed line at $\lambda /W_{\rm fil}=2.79$ (Gaia~DR3) plotted in \textit {observable} units for reference (right y-axis). To compare directly with HGBS, multiply y-axis values by T1$=0.606$--$0.707$. Valid at $f = 0.9$--$1.3$ only; \emph {upper bound} for supercritical filaments (see Figure~\ref {fig:C7_critical} for direct simulation measurements)}{figure.11}{}}
