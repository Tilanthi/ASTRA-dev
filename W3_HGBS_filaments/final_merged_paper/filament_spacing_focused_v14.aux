\@writefile{lof}{\contentsline {figure}{\numberline {19}{\ignorespaces Box-size convergence at $f=2.6$, $\beta =1.0$: $\lambda /W_{\rm  core}$ decreases from $4.22 \pm 0.34$ ($L_x=8$, 3 seeds) to $2.70 \pm 0.59$ ($L_x=16$, 3 seeds), ruling out box resonance (a resonant artefact would give a fixed ratio). Green band = HGBS window $[2.52, 3.08]$. $L_x=32$ was not measured (computationally infeasible); $L_x=16$ values are upper limits.}}{14}{figure.19}\protected@file@percent }
\newlabel{fig:RC_convergence}{{19}{14}{Box-size convergence at $f=2.6$, $\beta =1.0$: $\lambda /W_{\rm core}$ decreases from $4.22 \pm 0.34$ ($L_x=8$, 3 seeds) to $2.70 \pm 0.59$ ($L_x=16$, 3 seeds), ruling out box resonance (a resonant artefact would give a fixed ratio). Green band = HGBS window $[2.52, 3.08]$. $L_x=32$ was not measured (computationally infeasible); $L_x=16$ values are upper limits}{figure.19}{}}
