\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Definitive Transition Campaign (DTC): fragmentation probability $P_{\rm  frag}$ in the $(\beta , f)$ plane for $\mathcal  {M} = 1$--$5$. Green circles: both seeds stable. Orange diamonds: seed-dependent outcome. Red crosses: both seeds fragmented. The transition boundary shifts systematically to lower $\beta $ as $\mathcal  {M}$ increases. \textbf  {Updated April 2026}: Re-runs with 6-hour timeouts showed that all STABLE points at $\beta = 0.3$, $\mathcal  {M} = 1$ are timeout artifacts.}}{10}{figure.2}\protected@file@percent }
\newlabel{fig:dtc_pfrag}{{2}{10}{Definitive Transition Campaign (DTC): fragmentation probability $P_{\rm frag}$ in the $(\beta , f)$ plane for $\mathcal {M} = 1$--$5$. Green circles: both seeds stable. Orange diamonds: seed-dependent outcome. Red crosses: both seeds fragmented. The transition boundary shifts systematically to lower $\beta $ as $\mathcal {M}$ increases. \textbf {Updated April 2026}: Re-runs with 6-hour timeouts showed that all STABLE points at $\beta = 0.3$, $\mathcal {M} = 1$ are timeout artifacts}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Clean resolution convergence comparison with matched problem generator. All points show $t_{\rm  frag}(256^3)$ versus $t_{\rm  frag}(128^3)$. Points lie within the $\pm 10\%$ convergence band. Mean ratio is $0.928 \pm 0.016$ (256$^3$ fragments 7.2\% earlier). Diagonal line shows perfect agreement.}}{10}{figure.3}\protected@file@percent }
\newlabel{fig:resolution}{{3}{10}{Clean resolution convergence comparison with matched problem generator. All points show $t_{\rm frag}(256^3)$ versus $t_{\rm frag}(128^3)$. Points lie within the $\pm 10\%$ convergence band. Mean ratio is $0.928 \pm 0.016$ (256$^3$ fragments 7.2\% earlier). Diagonal line shows perfect agreement}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Initial condition sensitivity test. Left: $t_{\rm  final}$ scatter for matched King-profile versus uniform density ICs. Right: $t_{\rm  final}$ bar chart. Both IC types classify every point identically (all STABLE).}}{10}{figure.4}\protected@file@percent }
\newlabel{fig:ic_sensitivity}{{4}{10}{Initial condition sensitivity test. Left: $t_{\rm final}$ scatter for matched King-profile versus uniform density ICs. Right: $t_{\rm final}$ bar chart. Both IC types classify every point identically (all STABLE)}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Equation of state sensitivity test. Left: fragmentation time vs. $\gamma $ (all parameter points). Right: $t_{\rm  frag}/t_{\rm  final}$ vs. $\gamma $ with lines connecting same $(f, \beta , \mathcal  {M})$ points. Sub-isothermal EOS ($\gamma < 1$) systematically reduces $t_{\rm  frag}$.}}{10}{figure.5}\protected@file@percent }
\newlabel{fig:eos_sensitivity}{{5}{10}{Equation of state sensitivity test. Left: fragmentation time vs. $\gamma $ (all parameter points). Right: $t_{\rm frag}/t_{\rm final}$ vs. $\gamma $ with lines connecting same $(f, \beta , \mathcal {M})$ points. Sub-isothermal EOS ($\gamma < 1$) systematically reduces $t_{\rm frag}$}{figure.5}{}}
