\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Three-regime fragmentation framework from 208 Athena++ simulations. Color shows density contrast $C$. The three regimes are: (1) Magnetically subcritical (red, $\beta \leq 0.15$): minimal fragmentation; (2) Magnetically regulated (yellow/orange, $0.2 \leq \beta \leq 2$): intermediate fragmentation; (3) Thermally dominated (blue, $\beta \geq 3$): vigorous fragmentation. Typical HGBS filament conditions ($\mathcal  {M} \approx 2$--$3$, $\beta \approx 0.5$--$1.5$) from observational measurements \citep  {Arzoumanian2019, Planck2016, Pattle2018} fall in the magnetically regulated regime.}}{23}{figure.8}\protected@file@percent }
\newlabel{fig:regime}{{8}{23}{Three-regime fragmentation framework from 208 Athena++ simulations. Color shows density contrast $C$. The three regimes are: (1) Magnetically subcritical (red, $\beta \leq 0.15$): minimal fragmentation; (2) Magnetically regulated (yellow/orange, $0.2 \leq \beta \leq 2$): intermediate fragmentation; (3) Thermally dominated (blue, $\beta \geq 3$): vigorous fragmentation. Typical HGBS filament conditions ($\mathcal {M} \approx 2$--$3$, $\beta \approx 0.5$--$1.5$) from observational measurements \citep {Arzoumanian2019, Planck2016, Pattle2018} fall in the magnetically regulated regime}{figure.8}{}}
