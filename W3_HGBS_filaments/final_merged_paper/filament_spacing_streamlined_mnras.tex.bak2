\label{tab:ctzm}
\begin{tabular}{lcccc}
\toprule
Line-mass fraction $f$ & $\beta = 0.3$ & $\beta = 0.5$ & $\beta = 1.0$ & $\beta = 2.0$ \\
\midrule
1.2 & $5.37 \pm 0.40$ & $3.95 \pm 0.45$ & $3.23 \pm 0.24$ & $2.91 \pm 0.29$ \\
1.3 & $5.31 \pm 0.53$ & $3.72 \pm 0.45$ & $3.17 \pm 0.28$ & $2.79 \pm 0.24$ \\
1.4 & $5.05 \pm 0.69$ & $3.68 \pm 0.28$ & $3.10 \pm 0.24$ & $2.76 \pm 0.22$ \\
1.5 & $4.70 \pm 0.76$ & $3.50 \pm 0.26$ & $3.07 \pm 0.30$ & $2.86 \pm 0.29$ \\
\midrule
Slope ($\Delta(\lambda/W)/\Delta f$) & $-2.24$ & $-1.39$ & $-0.55$ & $-0.20$ \\
