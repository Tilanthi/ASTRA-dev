\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Left: Fragmentation onset time $t_{\rm  frag}$ versus line-mass fraction $f$ for all $\beta $ (colour) and $\mathcal  {M}$ (marker). The power-law fit $1/t_{\rm  frag} \propto f^{0.39}$ ($r^2 = 0.999$) is shown as the dashed line. Right: Heatmap of mean $t_{\rm  frag}$ in the $(\beta , f)$ plane. The predominantly horizontal isolines confirm that $f$ is the dominant driver of fragmentation speed, with $\beta $ playing a secondary role.}}{15}{figure.8}\protected@file@percent }
\newlabel{fig:tfrag_combined}{{8}{15}{Left: Fragmentation onset time $t_{\rm frag}$ versus line-mass fraction $f$ for all $\beta $ (colour) and $\mathcal {M}$ (marker). The power-law fit $1/t_{\rm frag} \propto f^{0.39}$ ($r^2 = 0.999$) is shown as the dashed line. Right: Heatmap of mean $t_{\rm frag}$ in the $(\beta , f)$ plane. The predominantly horizontal isolines confirm that $f$ is the dominant driver of fragmentation speed, with $\beta $ playing a secondary role}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Extension campaigns testing Mach number and high-$\beta $ dependence. Left panel: $t_{\rm  frag}$ versus $f$ for $\mathcal  {M} = 0.5$--$3.0$, showing complete independence of Mach number. Right panel: $t_{\rm  frag}$ versus $f$ for $\beta = 0.3$--$5.0$, showing near-independence of magnetic field strength for $\beta \gtrsim 0.5$.}}{15}{figure.9}\protected@file@percent }
\newlabel{fig:mach_highbeta}{{9}{15}{Extension campaigns testing Mach number and high-$\beta $ dependence. Left panel: $t_{\rm frag}$ versus $f$ for $\mathcal {M} = 0.5$--$3.0$, showing complete independence of Mach number. Right panel: $t_{\rm frag}$ versus $f$ for $\beta = 0.3$--$5.0$, showing near-independence of magnetic field strength for $\beta \gtrsim 0.5$}{figure.9}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.8.2}Phase 2: Perpendicular Field Geometry (96 simulations)}{15}{subsubsection.4.8.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Near-critical regime ($f = 1.1$--$1.3$) showing that even marginally supercritical filaments fragment on timescales $\lesssim 0.4\,t_{\rm  J}$. Error bars show standard deviation across turbulence seeds. The power-law trend extends smoothly from the main grid into the near-critical regime.}}{16}{figure.10}\protected@file@percent }
\newlabel{fig:nearcrit}{{10}{16}{Near-critical regime ($f = 1.1$--$1.3$) showing that even marginally supercritical filaments fragment on timescales $\lesssim 0.4\,t_{\rm J}$. Error bars show standard deviation across turbulence seeds. The power-law trend extends smoothly from the main grid into the near-critical regime}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Theoretical fragmentation spacing $\lambda /W_{\rm  core}$ versus plasma $\beta $ from the field-geometry-calibrated formula $\lambda _{\rm  frag} = 1.11\,\lambda _{MJ}(\theta , \beta )$. For longitudinal B-field ($\theta = 0^\circ $), $\lambda /W = 3.70$ (independent of $\beta $). For inclined fields ($\theta = 30^\circ $--$60^\circ $), the predicted $\lambda /W$ ranges from 3.8 to 5.5. The Gaia DR3-corrected HGBS observational value ($\lambda /W = 2.79 \pm 0.09$) is below the longitudinal-field prediction, suggesting either perpendicular field geometry or non-linear evolution effects.}}{16}{figure.11}\protected@file@percent }
\newlabel{fig:lambda_theory}{{11}{16}{Theoretical fragmentation spacing $\lambda /W_{\rm core}$ versus plasma $\beta $ from the field-geometry-calibrated formula $\lambda _{\rm frag} = 1.11\,\lambda _{MJ}(\theta , \beta )$. For longitudinal B-field ($\theta = 0^\circ $), $\lambda /W = 3.70$ (independent of $\beta $). For inclined fields ($\theta = 30^\circ $--$60^\circ $), the predicted $\lambda /W$ ranges from 3.8 to 5.5. The Gaia DR3-corrected HGBS observational value ($\lambda /W = 2.79 \pm 0.09$) is below the longitudinal-field prediction, suggesting either perpendicular field geometry or non-linear evolution effects}{figure.11}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {4.8.3}Phase 3: Oblique Field Calibration (108 simulations)}{16}{subsubsection.4.8.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Near-critical fragmentation threshold: $t_{\rm  frag}$ heatmaps in the $(\beta , f)$ plane for $\mathcal  {M} = 1$ (left) and $\mathcal  {M} = 2$ (right). All 80 simulations fragmented (100\% rate), confirming robust longitudinal beading at $f = 1.00$--$1.20$. Color bar shows $t_{\rm  frag}$ in units of $t_{\rm  J}$.}}{17}{figure.12}\protected@file@percent }
\newlabel{fig:beading_threshold}{{12}{17}{Near-critical fragmentation threshold: $t_{\rm frag}$ heatmaps in the $(\beta , f)$ plane for $\mathcal {M} = 1$ (left) and $\mathcal {M} = 2$ (right). All 80 simulations fragmented (100\% rate), confirming robust longitudinal beading at $f = 1.00$--$1.20$. Color bar shows $t_{\rm frag}$ in units of $t_{\rm J}$}{figure.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Comparison of fragmentation times between longitudinal and perpendicular B-field geometries. Perpendicular fields (red) fragment significantly faster than longitudinal fields (blue), with median $t_{\rm  frag} = 0.381\,t_{\rm  J}$ (perpendicular) versus $1.081\,t_{\rm  J}$ (longitudinal). Error bars show standard deviation across random seeds.}}{17}{figure.13}\protected@file@percent }
\newlabel{fig:perp_comparison}{{13}{17}{Comparison of fragmentation times between longitudinal and perpendicular B-field geometries. Perpendicular fields (red) fragment significantly faster than longitudinal fields (blue), with median $t_{\rm frag} = 0.381\,t_{\rm J}$ (perpendicular) versus $1.081\,t_{\rm J}$ (longitudinal). Error bars show standard deviation across random seeds}{figure.13}{}}
