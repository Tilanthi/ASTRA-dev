\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Left: Fragmentation onset time $t_{\rm  frag}$ versus line-mass fraction $f$ for all $\beta $ (colour) and $\mathcal  {M}$ (marker). The power-law fit $1/t_{\rm  frag} \propto f^{0.39}$ ($r^2 = 0.999$) is shown as the dashed line. Right: Heatmap of mean $t_{\rm  frag}$ in the $(\beta , f)$ plane. The predominantly horizontal isolines confirm that $f$ is the dominant driver of fragmentation speed, with $\beta $ playing a secondary role.}}{17}{figure.8}\protected@file@percent }
\newlabel{fig:tfrag_combined}{{8}{17}{Left: Fragmentation onset time $t_{\rm frag}$ versus line-mass fraction $f$ for all $\beta $ (colour) and $\mathcal {M}$ (marker). The power-law fit $1/t_{\rm frag} \propto f^{0.39}$ ($r^2 = 0.999$) is shown as the dashed line. Right: Heatmap of mean $t_{\rm frag}$ in the $(\beta , f)$ plane. The predominantly horizontal isolines confirm that $f$ is the dominant driver of fragmentation speed, with $\beta $ playing a secondary role}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Extension campaigns testing Mach number and high-$\beta $ dependence. Left panel: $t_{\rm  frag}$ versus $f$ for $\mathcal  {M} = 0.5$--$3.0$, showing complete independence of Mach number. Right panel: $t_{\rm  frag}$ versus $f$ for $\beta = 0.3$--$5.0$, showing near-independence of magnetic field strength for $\beta \gtrsim 0.5$.}}{17}{figure.9}\protected@file@percent }
\newlabel{fig:mach_highbeta}{{9}{17}{Extension campaigns testing Mach number and high-$\beta $ dependence. Left panel: $t_{\rm frag}$ versus $f$ for $\mathcal {M} = 0.5$--$3.0$, showing complete independence of Mach number. Right panel: $t_{\rm frag}$ versus $f$ for $\beta = 0.3$--$5.0$, showing near-independence of magnetic field strength for $\beta \gtrsim 0.5$}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Near-critical regime ($f = 1.1$--$1.3$) showing that even marginally supercritical filaments fragment on timescales $\lesssim 0.4\,t_{\rm  J}$. Error bars show standard deviation across turbulence seeds. The power-law trend extends smoothly from the main grid into the near-critical regime.}}{18}{figure.10}\protected@file@percent }
\newlabel{fig:nearcrit}{{10}{18}{Near-critical regime ($f = 1.1$--$1.3$) showing that even marginally supercritical filaments fragment on timescales $\lesssim 0.4\,t_{\rm J}$. Error bars show standard deviation across turbulence seeds. The power-law trend extends smoothly from the main grid into the near-critical regime}{figure.10}{}}
