\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Oblique field calibration: $t_{\rm  frag}$ versus field angle $\theta $ for $f = 1.5$--$3.0$ and $\beta = 0.5$--$2.0$. The smooth decrease from $0.604\,t_{\rm  J}$ ($30^\circ $) to $0.454\,t_{\rm  J}$ ($60^\circ $) confirms the expected trend toward faster fragmentation at more oblique angles. Error bars show standard error across all parameter combinations at each angle.}}{18}{figure.14}\protected@file@percent }
\newlabel{fig:oblique_calibration}{{14}{18}{Oblique field calibration: $t_{\rm frag}$ versus field angle $\theta $ for $f = 1.5$--$3.0$ and $\beta = 0.5$--$2.0$. The smooth decrease from $0.604\,t_{\rm J}$ ($30^\circ $) to $0.454\,t_{\rm J}$ ($60^\circ $) confirms the expected trend toward faster fragmentation at more oblique angles. Error bars show standard error across all parameter combinations at each angle}{figure.14}{}}
