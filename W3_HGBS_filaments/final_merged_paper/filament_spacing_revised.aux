\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Three-regime fragmentation framework from 208 Athena++ simulations spanning Mach number $M = 0.5$--$5$ and plasma $\beta = 0.05$--$5$. Colour shows density contrast $C$. The three regimes are: (1) Magnetically subcritical (red, $\beta \leq 0.15$): minimal fragmentation; (2) Magnetically regulated (yellow/orange, $0.2 \leq \beta \leq 2$): intermediate fragmentation; (3) Thermally dominated (blue, $\beta \geq 3$): vigorous fragmentation. The W3 filament complex conditions ($M = 2.5$--$3.5$, $\beta = 0.5$--$1.5$) fall in the magnetically regulated regime.}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:regime}{{2}{5}{Three-regime fragmentation framework from 208 Athena++ simulations spanning Mach number $M = 0.5$--$5$ and plasma $\beta = 0.05$--$5$. Colour shows density contrast $C$. The three regimes are: (1) Magnetically subcritical (red, $\beta \leq 0.15$): minimal fragmentation; (2) Magnetically regulated (yellow/orange, $0.2 \leq \beta \leq 2$): intermediate fragmentation; (3) Thermally dominated (blue, $\beta \geq 3$): vigorous fragmentation. The W3 filament complex conditions ($M = 2.5$--$3.5$, $\beta = 0.5$--$1.5$) fall in the magnetically regulated regime}{figure.2}{}}
