\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Theoretical $\lambda /W$ for oblique fields from the \citet  {Nakamura1993} dispersion relation (full numerical solution). Values awaiting simulation confirmation. The $\theta =90^\circ $ theoretical value approaches $4\times W$ (weak axial tension), while the Campaign\nobreakspace  {}6 simulation gives $\lambda /W=1.25$ because those simulations were run at $f=1.5$--$3.0$ (supercritical regime, radial collapse dominant), not at near-critical conditions. The correct comparison for field-geometry effects at fixed $f\approx 1$ is with the theoretical values shown here.}}{18}{table.9}\protected@file@percent }
\newlabel{tab:oblique_theory}{{9}{18}{Theoretical $\lambda /W$ for oblique fields from the \citet {Nakamura1993} dispersion relation (full numerical solution). Values awaiting simulation confirmation. The $\theta =90^\circ $ theoretical value approaches $4\times W$ (weak axial tension), while the Campaign~6 simulation gives $\lambda /W=1.25$ because those simulations were run at $f=1.5$--$3.0$ (supercritical regime, radial collapse dominant), not at near-critical conditions. The correct comparison for field-geometry effects at fixed $f\approx 1$ is with the theoretical values shown here}{table.9}{}}
