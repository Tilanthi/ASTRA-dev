\newlabel{fig:tfrag_combined}{{8}{11}{Left: Fragmentation onset time $t_{\rm frag}$ versus line-mass fraction $f$ for all $\beta $ (colour) and $\mathcal {M}$ (marker). Power-law fit $1/t_{\rm frag} \propto f^{0.39}$ ($r^2 = 0.999$) shown dashed. Right: Heatmap of mean $t_{\rm frag}$ in the $(\beta , f)$ plane, confirming $f$ as the dominant driver}{figure.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Left: $t_{\rm  frag}$ versus $f$ for $\mathcal  {M} = 0.5$--$3.0$, showing complete Mach-number independence. Right: $t_{\rm  frag}$ versus $f$ for $\beta = 0.3$--$5.0$, showing near-independence of field strength for $\beta \gtrsim 0.5$.}}{11}{figure.9}\protected@file@percent }
\newlabel{fig:mach_highbeta}{{9}{11}{Left: $t_{\rm frag}$ versus $f$ for $\mathcal {M} = 0.5$--$3.0$, showing complete Mach-number independence. Right: $t_{\rm frag}$ versus $f$ for $\beta = 0.3$--$5.0$, showing near-independence of field strength for $\beta \gtrsim 0.5$}{figure.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Near-critical regime ($f = 1.1$--$1.3$): fragmentation timescales $\lesssim 0.4\,t_{\rm  J}$. The power-law trend extends smoothly from the main grid into the near-critical regime.}}{11}{figure.10}\protected@file@percent }
\newlabel{fig:nearcrit}{{10}{11}{Near-critical regime ($f = 1.1$--$1.3$): fragmentation timescales $\lesssim 0.4\,t_{\rm J}$. The power-law trend extends smoothly from the main grid into the near-critical regime}{figure.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces Theoretical $\lambda /W_{\rm  core}$ versus $\beta $ from the field-geometry-calibrated formula $\lambda _{\rm  frag} = 1.11\,\lambda _{MJ}(\theta , \beta )$. For $\theta = 0^\circ $, $\lambda /W = 3.70$ independent of $\beta $. The Gaia DR3 HGBS value ($\lambda /W = 2.79$, horizontal band) lies below the longitudinal-field prediction. \textbf  {Note on extrapolation uncertainty}: this formula was calibrated from near-critical simulations ($f = 0.9$--$1.3$); for supercritical filaments ($f \geq 1.5$) it represents an order-of-magnitude upper bound only (Section\nobreakspace  {}\ref  {sec:supercrit}), with an associated uncertainty of a factor of 1--2. This uncertainty is not shown on the figure.}}{12}{figure.11}\protected@file@percent }
\newlabel{fig:lambda_theory}{{11}{12}{Theoretical $\lambda /W_{\rm core}$ versus $\beta $ from the field-geometry-calibrated formula $\lambda _{\rm frag} = 1.11\,\lambda _{MJ}(\theta , \beta )$. For $\theta = 0^\circ $, $\lambda /W = 3.70$ independent of $\beta $. The Gaia DR3 HGBS value ($\lambda /W = 2.79$, horizontal band) lies below the longitudinal-field prediction. \textbf {Note on extrapolation uncertainty}: this formula was calibrated from near-critical simulations ($f = 0.9$--$1.3$); for supercritical filaments ($f \geq 1.5$) it represents an order-of-magnitude upper bound only (Section~\ref {sec:supercrit}), with an associated uncertainty of a factor of 1--2. This uncertainty is not shown on the figure}{figure.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Near-critical fragmentation: $t_{\rm  frag}$ heatmaps in the $(\beta , f)$ plane for $\mathcal  {M} = 1$ (left) and $\mathcal  {M} = 2$ (right). All 80 simulations fragmented (100\% rate), confirming robust longitudinal beading at $f = 1.00$--$1.20$.}}{12}{figure.12}\protected@file@percent }
\newlabel{fig:beading_threshold}{{12}{12}{Near-critical fragmentation: $t_{\rm frag}$ heatmaps in the $(\beta , f)$ plane for $\mathcal {M} = 1$ (left) and $\mathcal {M} = 2$ (right). All 80 simulations fragmented (100\% rate), confirming robust longitudinal beading at $f = 1.00$--$1.20$}{figure.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Fragmentation timescales for perpendicular ($f=1.5$--$3.0$) vs.\ near-critical longitudinal ($f=1.0$--$1.2$) campaigns. The timescale difference ($0.381$ vs $1.081\,t_{\rm  J}$) reflects both field geometry and different $f$ regimes; the field geometry effect in isolation is captured in the oblique-field theoretical predictions (Table\nobreakspace  {}\ref  {tab:oblique_theory}).}}{12}{figure.13}\protected@file@percent }
\newlabel{fig:perp_comparison}{{13}{12}{Fragmentation timescales for perpendicular ($f=1.5$--$3.0$) vs.\ near-critical longitudinal ($f=1.0$--$1.2$) campaigns. The timescale difference ($0.381$ vs $1.081\,t_{\rm J}$) reflects both field geometry and different $f$ regimes; the field geometry effect in isolation is captured in the oblique-field theoretical predictions (Table~\ref {tab:oblique_theory})}{figure.13}{}}
