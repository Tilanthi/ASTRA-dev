\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Distribution of fragmentation scales from 3,240 linear perturbation theory simulations. The green shaded region indicates the 3D-corrected observed range ($2$--$2.7\times W_{\rm  fil}$). The red dashed line shows the classical IM92 prediction ($4\times W_{\rm  fil}$). Approximately 8.7\% of simulations fall in this 3D-corrected range. If the projected range ($2$--$3\times W_{\rm  fil}$) is used instead, 20.6\% of simulations fall within the target. The percentage depends on the chosen observational target range; the key result is that physically reasonable parameter values can reproduce the observations.}}{13}{}\protected@file@percent }
\newlabel{fig:distribution}{{2}{13}}
\citation{Inutsuka1997}
\citation{Fischera2012}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4}Physical Interpretation and Quantitative Grounding}{14}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Physical mechanism decomposition showing how finite length, external pressure, geometry, and accretion combine to reduce the classical $4\times W_{\rm  fil}$ prediction. Green shading indicates the observed range ($2$--$2.7\times W_{\rm  fil}$). Each bar shows the cumulative effect of adding successive physical mechanisms. \textbf  {Note}: The specific parameters shown ($f_{\rm  finite} = 0.60$, $f_{\rm  pressure} = 0.70$, $f_{\rm  geom} = 0.85$, $f_{\rm  acc} = 0.70$) represent a maximum-correction end-member that demonstrates the combined effect is strong. This combination yields $1.00\times W_{\rm  fil}$ which undershoots the observed range, illustrating that parameter choice matters. Representative combinations that fall within the observed range include: $f_{\rm  finite} = 0.70$, $f_{\rm  pressure} = 0.80$, $f_{\rm  geom} = 0.90$, $f_{\rm  acc} = 0.80$ (yielding $1.62\times $) and $f_{\rm  finite} = 0.60$, $f_{\rm  pressure} = 0.75$, $f_{\rm  geom} = 0.90$, $f_{\rm  acc} = 0.90$ (yielding $2.19\times $). The full parameter space is shown in Fig.\nobreakspace  {}2\hbox {}.}}{14}{}\protected@file@percent }
\newlabel{fig:mechanism}{{3}{14}}
