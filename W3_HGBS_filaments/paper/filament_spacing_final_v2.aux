\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Core spacing comparison with theoretical predictions.} Blue bars show observed \textit  {projected} core spacing for four HGBS regions with error bars (standard error of the mean). Green dashed line indicates the classical $4\times $ prediction (0.4 pc) for 3D spacing. Yellow dashed line shows the $4\times $ prediction corrected for projection (0.31 pc). Orange dashed line shows the observed weighted mean (0.21 pc). The discrepancy between observation ($2.7\times $ in 3D) and theory ($4\times $) is substantially reduced when projection is properly accounted for.}}{6}{}\protected@file@percent }
\newlabel{fig:spacing}{{1}{6}}
