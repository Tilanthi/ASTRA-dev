\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Test Case 6: Mass-Metallicity Relation}. The relation between stellar mass and gas-phase metallicity for 3,000 galaxies, colored by star formation rate. ASTRA recovered the expected slope of 0.30 \citep  {tremonti2004}. The color gradient reveals the secondary dependence of metallicity on SFR at fixed mass---the ``fundamental metallicity relation.''}}{15}{figure.8}\protected@file@percent }
\newlabel{fig:test06b}{{8}{15}{\textbf {Test Case 6: Mass-Metallicity Relation}. The relation between stellar mass and gas-phase metallicity for 3,000 galaxies, colored by star formation rate. ASTRA recovered the expected slope of 0.30 \citep {tremonti2004}. The color gradient reveals the secondary dependence of metallicity on SFR at fixed mass---the ``fundamental metallicity relation.''}{figure.8}{}}
