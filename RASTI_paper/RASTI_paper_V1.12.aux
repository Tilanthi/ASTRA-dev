\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \textbf  {Test Case 7: Density Contrast vs Time from MHD Filament Fragmentation}. Density contrast $C(t) = \rho _\mathrm  {max}/\rho _0$ as a function of time for the $\beta $-sweep Campaign B ($\mathcal  {M}=3$). Magnetically stable runs ($\beta \leq 0.50$, above the critical threshold $\beta _\mathrm  {crit} = 0.667$) remain near $C\approx 1$, while unstable runs ($\beta \geq 0.70$) show rapid growth. $C_\mathrm  {final}$ at $t = 4\,t_J$ varies by $4.3\times $ across the $\beta $ range, confirming plasma $\beta $ as the dominant parameter controlling ISM filament fragmentation. The seeded fragmentation wavelength is $\lambda _\mathrm  {frag} = 2.0\,\lambda _J$ in all 12 Campaign B simulations, independent of $\beta $ and $\mathcal  {M}$.}}{18}{figure.11}\protected@file@percent }
\newlabel{fig:mhd_contrast_sweep}{{11}{18}{\textbf {Test Case 7: Density Contrast vs Time from MHD Filament Fragmentation}. Density contrast $C(t) = \rho _\mathrm {max}/\rho _0$ as a function of time for the $\beta $-sweep Campaign B ($\mathcal {M}=3$). Magnetically stable runs ($\beta \leq 0.50$, above the critical threshold $\beta _\mathrm {crit} = 0.667$) remain near $C\approx 1$, while unstable runs ($\beta \geq 0.70$) show rapid growth. $C_\mathrm {final}$ at $t = 4\,t_J$ varies by $4.3\times $ across the $\beta $ range, confirming plasma $\beta $ as the dominant parameter controlling ISM filament fragmentation. The seeded fragmentation wavelength is $\lambda _\mathrm {frag} = 2.0\,\lambda _J$ in all 12 Campaign B simulations, independent of $\beta $ and $\mathcal {M}$}{figure.11}{}}
