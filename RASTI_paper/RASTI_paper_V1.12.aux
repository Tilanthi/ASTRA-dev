\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces \textbf  {Test Case 7: Magnetic Stability Boundary in Parameter Space}. Stability boundary (fragmentation onset) mapped by 240-simulation Campaign C in the $(f, \beta )$ plane, where $f = \sqrt  {2/\beta }$ is the mass-to-flux ratio and $f_\mathrm  {crit} = \sqrt  {3} \approx 1.73$ is the theoretical threshold. Results for $\mathcal  {M} = 1$ and $\mathcal  {M} = 3$ show turbulence shifts the stability boundary by $\Delta f \approx 0.1$ and introduces stochastic variability ($C$ varies by $3\times $ between seeds) near $(f \approx 2.3, \beta \approx 0.7)$.}}{19}{figure.12}\protected@file@percent }
\newlabel{fig:mhd_stability}{{12}{19}{\textbf {Test Case 7: Magnetic Stability Boundary in Parameter Space}. Stability boundary (fragmentation onset) mapped by 240-simulation Campaign C in the $(f, \beta )$ plane, where $f = \sqrt {2/\beta }$ is the mass-to-flux ratio and $f_\mathrm {crit} = \sqrt {3} \approx 1.73$ is the theoretical threshold. Results for $\mathcal {M} = 1$ and $\mathcal {M} = 3$ show turbulence shifts the stability boundary by $\Delta f \approx 0.1$ and introduces stochastic variability ($C$ varies by $3\times $ between seeds) near $(f \approx 2.3, \beta \approx 0.7)$}{figure.12}{}}
\@writefile{toc}{\contentsline {section}{\numberline {10}Discussion}{19}{section.10}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {10.1}What ASTRA Demonstrates}{19}{subsection.10.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces \textbf  {Test Case 7: Injection-Recovery Bias Characterisation}. Pairwise median bias factor $f_\mathrm  {bias} = \lambda _\mathrm  {meas}/\lambda _\mathrm  {true}$ as a function of (A)\nobreakspace  {}core spacing, (B)\nobreakspace  {}number of cores, (C)\nobreakspace  {}noise level, and (D)\nobreakspace  {}background structure, from 320 injection-recovery simulations under Herschel-like conditions (SPIRE $250\,\mu $m beam FWHM = 18 arcsec, $d = 1.95$\nobreakspace  {}kpc). For $n = 7$ cores, $f_\mathrm  {bias} = 2.08 \pm 0.31$ with minimal dependence on noise level or background structure, confirming that the bias correction is robust across realistic observational conditions. The result agrees with the analytic prediction $k(n=7) = 2$ to within 4\nobreakspace  {}per\,cent, validating the analytical framework.}}{20}{figure.13}\protected@file@percent }
\newlabel{fig:mhd_bias}{{13}{20}{\textbf {Test Case 7: Injection-Recovery Bias Characterisation}. Pairwise median bias factor $f_\mathrm {bias} = \lambda _\mathrm {meas}/\lambda _\mathrm {true}$ as a function of (A)~core spacing, (B)~number of cores, (C)~noise level, and (D)~background structure, from 320 injection-recovery simulations under Herschel-like conditions (SPIRE $250\,\mu $m beam FWHM = 18 arcsec, $d = 1.95$~kpc). For $n = 7$ cores, $f_\mathrm {bias} = 2.08 \pm 0.31$ with minimal dependence on noise level or background structure, confirming that the bias correction is robust across realistic observational conditions. The result agrees with the analytic prediction $k(n=7) = 2$ to within 4~per\,cent, validating the analytical framework}{figure.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces \textbf  {Test Case 7: Isothermal vs Adiabatic EOS Comparison}. Density contrast $C(t) = \rho _\mathrm  {max}/\rho _0$ for matched isothermal (Campaign E Phase 1, solid lines) and adiabatic $\gamma = 5/3$ (Campaign E Phase 4, dashed lines) simulations at the same $(f, \beta )$ combinations ($f = 1.00$--$1.20$, $\beta = 0.5$--$1.0$). All isothermal runs show clear fragmentation ($C$ rising to $\gg 1$) within $t \lesssim 2\,t_J$. All adiabatic runs remain near $C \approx 1$ for the full 5-hour runtime ($t \gg 30\,t_J$). The isothermal EOS is thus confirmed as the conservative (worst-case) fragmentation limit.}}{20}{figure.14}\protected@file@percent }
\newlabel{fig:mhd_adiabatic}{{14}{20}{\textbf {Test Case 7: Isothermal vs Adiabatic EOS Comparison}. Density contrast $C(t) = \rho _\mathrm {max}/\rho _0$ for matched isothermal (Campaign E Phase 1, solid lines) and adiabatic $\gamma = 5/3$ (Campaign E Phase 4, dashed lines) simulations at the same $(f, \beta )$ combinations ($f = 1.00$--$1.20$, $\beta = 0.5$--$1.0$). All isothermal runs show clear fragmentation ($C$ rising to $\gg 1$) within $t \lesssim 2\,t_J$. All adiabatic runs remain near $C \approx 1$ for the full 5-hour runtime ($t \gg 30\,t_J$). The isothermal EOS is thus confirmed as the conservative (worst-case) fragmentation limit}{figure.14}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces \textbf  {Test Case 7: Oblique Field Calibration at Near-Critical Density}. Mean fragmentation timescale $\langle t_\mathrm  {frag} \rangle / t_J$ versus field inclination angle $\theta $ for near-critical isothermal simulations ($f = 1.00$--$1.20$) from Campaign E Phase 3 (36 sims each angle). Error bars show the standard deviation across 36 parameter combinations. Unlike the non-monotonic dependence at $f = 1.5$--$2.0$ (Campaign D), near-critical $t_\mathrm  {frag}$ decreases monotonically with $\theta $: oblique fields progressively remove Alfv\'{e}n tension support, accelerating fragmentation. The longitudinal case (Phase 1 median $1.081\,t_J$, leftmost point) provides the longest timescale; perpendicular (Phase 2 median $0.381\,t_J$, rightmost point) the shortest.}}{21}{figure.15}\protected@file@percent }
\newlabel{fig:mhd_oblique}{{15}{21}{\textbf {Test Case 7: Oblique Field Calibration at Near-Critical Density}. Mean fragmentation timescale $\langle t_\mathrm {frag} \rangle / t_J$ versus field inclination angle $\theta $ for near-critical isothermal simulations ($f = 1.00$--$1.20$) from Campaign E Phase 3 (36 sims each angle). Error bars show the standard deviation across 36 parameter combinations. Unlike the non-monotonic dependence at $f = 1.5$--$2.0$ (Campaign D), near-critical $t_\mathrm {frag}$ decreases monotonically with $\theta $: oblique fields progressively remove Alfv\'{e}n tension support, accelerating fragmentation. The longitudinal case (Phase 1 median $1.081\,t_J$, leftmost point) provides the longest timescale; perpendicular (Phase 2 median $0.381\,t_J$, rightmost point) the shortest}{figure.15}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces \textbf  {Test Case 7: Fragmentation Timescale vs Field Inclination Angle}. Fragmentation timescale $t_\mathrm  {frag}/t_J$ as a function of field inclination angle $\theta $ (longitudinal $0^\circ $ through perpendicular $90^\circ $) at $f = 1.5$, $\beta = 1.0$, $\mathcal  {M} = 1$ from 40 additional simulations. The non-monotonic dependence peaks at $\theta \approx 30^\circ $, where Alfv\'{e}n tension along the filament axis is maximised. The longitudinal case ($\theta = 0^\circ $) gives the shortest $t_\mathrm  {frag}$, confirming that the DTC campaign assumption is conservative.}}{21}{figure.16}\protected@file@percent }
\newlabel{fig:tc7_angle}{{16}{21}{\textbf {Test Case 7: Fragmentation Timescale vs Field Inclination Angle}. Fragmentation timescale $t_\mathrm {frag}/t_J$ as a function of field inclination angle $\theta $ (longitudinal $0^\circ $ through perpendicular $90^\circ $) at $f = 1.5$, $\beta = 1.0$, $\mathcal {M} = 1$ from 40 additional simulations. The non-monotonic dependence peaks at $\theta \approx 30^\circ $, where Alfv\'{e}n tension along the filament axis is maximised. The longitudinal case ($\theta = 0^\circ $) gives the shortest $t_\mathrm {frag}$, confirming that the DTC campaign assumption is conservative}{figure.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces \textbf  {Test Case 7: Near-Critical Fragmentation Timescales}. Fragmentation timescale $t_\mathrm  {frag}/t_J$ vs line-mass fraction $f = M_\mathrm  {line}/M_\mathrm  {crit}$ from 36 near-critical simulations ($f = 1.00$--$1.05$, longitudinal B) and the DTC main campaign ($f = 1.0$--$3.0$). All 36 near-critical simulations fragmented. $t_\mathrm  {frag}$ rises steeply near $f = 1.0$ (increasing by $\sim 1.8\times $ from $\beta = 2.0$ to $\beta = 0.3$), demonstrating that no stability boundary exists in the simulation grid at $\beta \leq 2.0$, and that the DTC fragmentation criterion is physically robust.}}{22}{figure.17}\protected@file@percent }
\newlabel{fig:tc7_nearcrit}{{17}{22}{\textbf {Test Case 7: Near-Critical Fragmentation Timescales}. Fragmentation timescale $t_\mathrm {frag}/t_J$ vs line-mass fraction $f = M_\mathrm {line}/M_\mathrm {crit}$ from 36 near-critical simulations ($f = 1.00$--$1.05$, longitudinal B) and the DTC main campaign ($f = 1.0$--$3.0$). All 36 near-critical simulations fragmented. $t_\mathrm {frag}$ rises steeply near $f = 1.0$ (increasing by $\sim 1.8\times $ from $\beta = 2.0$ to $\beta = 0.3$), demonstrating that no stability boundary exists in the simulation grid at $\beta \leq 2.0$, and that the DTC fragmentation criterion is physically robust}{figure.17}{}}
