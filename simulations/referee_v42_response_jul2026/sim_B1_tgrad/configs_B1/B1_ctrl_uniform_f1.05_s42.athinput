<comment>
problem = B1 T-gradient, higher seed for near-simultaneous beading (measure warm vs cool lambda)

<job>
problem_id = B1_ctrl_uniform_f1.05_s42
num_cores  = 32

<output1>
file_type = hdf5
variable  = prim
dt        = 0.05
id        = prim

<output2>
file_type = hst
dt        = 0.01
id        = hst

<time>
cfl_number = 0.3
tlim       = 1.5
nlim       = -1

<mesh>
nx1 = 512
x1min = 0.0
x1max = 16.0
ix1_bc = periodic
ox1_bc = periodic
nx2 = 64
x2min = -1.0
x2max = 1.0
ix2_bc = periodic
ox2_bc = periodic
nx3 = 64
x3min = -1.0
x3max = 1.0
ix3_bc = periodic
ox3_bc = periodic

<meshblock>
nx1 = 16
nx2 = 64
nx3 = 64

<hydro>
gamma            = 1.0001
iso_sound_speed  = 1.0
dfloor           = 1e-6
pfloor           = 1e-9

<gravity>
grav_mean_rho = 1.0

<problem>
four_pi_G       = 39.4784176044
f_line_mass     = 1.05
plasma_beta     = 1.0
bfield_geometry = longitudinal
mach_number     = 1.0
perturb_ampl    = 1.0e-2
tgrad_amp       = 0.0
W_core          = 0.3
random_seed     = 42
