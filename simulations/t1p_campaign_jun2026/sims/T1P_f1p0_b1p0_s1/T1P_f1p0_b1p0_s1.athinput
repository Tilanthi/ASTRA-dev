<comment>
problem   = t1_plummer_correction
job_label = T1P_f1p0_b1p0_s1

<job>
problem_id  = filament_frag

<output1>
file_type   = hdf5
variable    = prim
dt          = 0.05
id          = prim

<output2>
file_type   = hst
dt          = 0.005
id          = hst

<time>
cfl_number  = 0.3
tlim        = 2.5
nlim        = -1

<mesh>
nx1         = 256
x1min       = -4.0000
x1max       = 4.0000
ix1_bc      = periodic
ox1_bc      = periodic

nx2         = 64
x2min       = -1.0000
x2max       = 1.0000
ix2_bc      = user
ox2_bc      = user

nx3         = 64
x3min       = -1.0000
x3max       = 1.0000
ix3_bc      = user
ox3_bc      = user

<meshblock>
nx1 = 32
nx2 = 64
nx3 = 64

<hydro>
gamma           = 1.0
iso_sound_speed = 1.0

<gravity>
grav_mean_rho   = 1.0

<problem>
four_pi_G       = 39.4784176044
f_line_mass     = 1.00
plasma_beta     = 1.00
theta_deg       = 0.0
mach_number     = 1.0
perturb_ampl    = 1.0
random_seed     = 1
W_core          = 0.3
