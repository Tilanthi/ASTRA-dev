<comment>
problem   = SMK_ostr_refl
f=2.0 beta=1.0 bgeom=longitudinal profile=ostriker d=0.5 bc=reflecting seed=42 ampl=0.01

<job>
problem_id      = SMK_ostr_refl
max_runtime     = 43200
num_cores       = 2
restart_file    =

<output1>
file_type   = hdf5
variable    = prim
dt          = 0.01
id          = prim

<output2>
file_type   = hst
dt          = 0.001
id          = hst

<time>
cfl_number  = 0.3
tlim        = 0.02
nlim        = -1

<mesh>
nx1         = 64
x1min       = 0.0
x1max       = 8
ix1_bc      = periodic
ox1_bc      = periodic
nx2         = 32
x2min       = -0.5
x2max       = 0.5
ix2_bc      = reflecting
ox2_bc      = reflecting
nx3         = 32
x3min       = -0.5
x3max       = 0.5
ix3_bc      = reflecting
ox3_bc      = reflecting

<meshblock>
nx1 = 32
nx2 = 32
nx3 = 32

<hydro>
gamma           = 1.0
iso_sound_speed  = 1.0

<gravity>
grav_mean_rho   = 1.0

<problem>
four_pi_G       = 39.4784176044
f_line_mass     = 2.0
plasma_beta     = 1.0
bfield_geometry = longitudinal
mach_number     = 1.0
perturb_ampl    = 0.01
random_seed     = 42
W_core          = 0.3
profile         = ostriker
p_ext_ratio     = 0.0
