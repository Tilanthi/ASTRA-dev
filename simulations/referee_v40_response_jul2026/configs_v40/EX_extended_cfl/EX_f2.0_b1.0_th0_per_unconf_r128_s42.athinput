<comment>
problem   = EX_f2.0_b1.0_th0_per_unconf_r128_s42
EX: extended integration, dt_kill disabled, unconfined periodic, res=r128

<job>
problem_id      = EX_f2.0_b1.0_th0_per_unconf_r128_s42
max_runtime     = 21600
num_cores       = 32

<output1>
file_type   = hdf5
variable    = prim
dt          = 0.01
id          = prim

<output2>
file_type   = hst
dt          = 0.001
id          = hst

<time>
cfl_number  = 0.3
tlim        = 1.5
nlim        = -1

<mesh>
nx1         = 256
x1min       = 0.0
x1max       = 8
ix1_bc      = periodic
ox1_bc      = periodic
nx2         = 32
x2min       = -1.0
x2max       = 1.0
ix2_bc      = periodic
ox2_bc      = periodic
nx3         = 32
x3min       = -1.0
x3max       = 1.0
ix3_bc      = periodic
ox3_bc      = periodic

<meshblock>
nx1 = 16
nx2 = 16
nx3 = 16

<hydro>
gamma           = 1.0
iso_sound_speed  = 1.0

<gravity>
grav_mean_rho   = 1.0

<problem>
four_pi_G       = 39.4784176044
f_line_mass     = 2.0
plasma_beta     = 1.0
bfield_geometry = longitudinal
bfield_angle    = 0
mach_number     = 1.0
perturb_ampl    = 0.0001
random_seed     = 42
W_core          = 0.3
profile         = gaussian
p_ext_ratio     = 0.0
dt_kill         = 1e-12
