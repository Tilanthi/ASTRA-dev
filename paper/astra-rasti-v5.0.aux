\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Verified scientific discoveries recovered by \textsc  {Astra}\xspace  during autonomous operation. Kepler's Third Law from 2\,839 exoplanets (slope 1.497 vs.\ theory 1.500, $R^{2} = 0.9982$); accelerating expansion from 1\,701 Type\nobreakspace  {}Ia supernovae ($+6.6$\,per\,cent excess slope indicating dark energy); galaxy colour bimodality from 2\,000 SDSS galaxies (blue fraction declining from 50\,per\,cent to 10\,per\,cent over 3\,Gyr); stellar populations from Gaia DR3; and causal inference correctly identifying redshift as causing colour changes.}}{8}{figure.4}\protected@file@percent }
\newlabel{fig:discoveries}{{4}{8}{Verified scientific discoveries recovered by \astra during autonomous operation. Kepler's Third Law from 2\,839 exoplanets (slope 1.497 vs.\ theory 1.500, $R^{2} = 0.9982$); accelerating expansion from 1\,701 Type~Ia supernovae ($+6.6$\,per\,cent excess slope indicating dark energy); galaxy colour bimodality from 2\,000 SDSS galaxies (blue fraction declining from 50\,per\,cent to 10\,per\,cent over 3\,Gyr); stellar populations from Gaia DR3; and causal inference correctly identifying redshift as causing colour changes}{figure.4}{}}
