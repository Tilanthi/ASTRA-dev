\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Safety monitoring dashboard. \emph  {Top left:} State-space mind trajectory projected onto the first two principal components (PC1: Confidence Variance, PC2: Domain Diversity), with concentric boundaries delineating nominal (green), caution (amber), and critical (red) operating regions; the system remains within the nominal basin after 50\nobreakspace  {}cycles. \emph  {Top right:} Anomaly detection drift monitor tracking five metrics in real time, with colour-coded severity (Nominal, Warning, Critical). \emph  {Bottom:} Composite alignment stability (78.4\,per\,cent) scored across six dimensions: Scientific Rigour (82\,per\,cent), Reproducibility (92\,per\,cent), Epistemic Humility (83\,per\,cent), Novelty Pursuit (71\,per\,cent), Resource Efficiency (64\,per\,cent), and Domain Balance (48\,per\,cent).}}{5}{figure.2}\protected@file@percent }
\newlabel{fig:dashboard:safety}{{2}{5}{Safety monitoring dashboard. \emph {Top left:} State-space mind trajectory projected onto the first two principal components (PC1: Confidence Variance, PC2: Domain Diversity), with concentric boundaries delineating nominal (green), caution (amber), and critical (red) operating regions; the system remains within the nominal basin after 50~cycles. \emph {Top right:} Anomaly detection drift monitor tracking five metrics in real time, with colour-coded severity (Nominal, Warning, Critical). \emph {Bottom:} Composite alignment stability (78.4\,per\,cent) scored across six dimensions: Scientific Rigour (82\,per\,cent), Reproducibility (92\,per\,cent), Epistemic Humility (83\,per\,cent), Novelty Pursuit (71\,per\,cent), Resource Efficiency (64\,per\,cent), and Domain Balance (48\,per\,cent)}{figure.2}{}}
