\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Scaling relations for 24 Herschel filaments identified by \textsc  {Astra}\xspace  . \emph  {Top panel:} Width distribution showing a characteristic scale of $0.098 \pm 0.019$\nobreakspace  {}pc, consistent with the ${\sim }0.1$\nobreakspace  {}pc ``universal width'' reported by \citet  {Arzoumanian2011} (though see \citealt  {Panopoulou2022} for discussion of apparent universality). \emph  {Bottom panel:} Line mass vs.\ velocity dispersion, showing the virial scaling relation with Pearson correlation $r = 0.988$, $p < 10^{-18}$.}}{5}{figure.1}\protected@file@percent }
\newlabel{fig:scaling}{{1}{5}{Scaling relations for 24 Herschel filaments identified by \astra . \emph {Top panel:} Width distribution showing a characteristic scale of $0.098 \pm 0.019$~pc, consistent with the ${\sim }0.1$~pc ``universal width'' reported by \citet {Arzoumanian2011} (though see \citealt {Panopoulou2022} for discussion of apparent universality). \emph {Bottom panel:} Line mass vs.\ velocity dispersion, showing the virial scaling relation with Pearson correlation $r = 0.988$, $p < 10^{-18}$}{figure.1}{}}
