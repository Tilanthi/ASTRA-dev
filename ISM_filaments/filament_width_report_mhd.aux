\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Resolution convergence test for filament width measurements. The measured width converges to $0.099 \pm 0.003$\nobreakspace  {}pc, in excellent agreement with the observed value of $0.1$\nobreakspace  {}pc (dashed red line). The difference between $512^3$ and $1024^3$ resolutions is $< 5\%$.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:convergence}{{1}{3}{Resolution convergence test for filament width measurements. The measured width converges to $0.099 \pm 0.003$~pc, in excellent agreement with the observed value of $0.1$~pc (dashed red line). The difference between $512^3$ and $1024^3$ resolutions is $< 5\%$}{figure.1}{}}
